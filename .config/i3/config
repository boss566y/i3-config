    #bindsym --whole-window  button9  workspace next_on_output

    bindsym Escape mode $remote
    bindsym F2 exec --no-startup-id $modes
    bindsym $mod+Shift+r restart
    bindsym $mod+F5 restart
    bindsym $mod+x exec --no-startup-id $display_select
    bindsym $mod+Shift+grave mode "default"
}


